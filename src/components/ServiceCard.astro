---
import Icon from './Icon.astro';

interface Props {
  title: string;
  href: string;
  summary: string;
  icon: string;
  index: number;
}
const { title, href, summary, icon, index } = Astro.props;
const num = String(index).padStart(2, '0');
---
<a href={href} class="svc">
  <div class="svc__top">
    <Icon name={icon} size={26} class="svc__icon" />
    <span class="svc__num">{num}</span>
  </div>
  <h3 class="svc__title">{title}</h3>
  <p class="svc__summary">{summary}</p>
  <span class="svc__link">
    Explore
    <Icon name="arrow" size={15} />
  </span>
</a>

<style>
  .svc {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.5rem 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    transition: transform var(--dur) var(--ease),
                border-color var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease);
  }
  .svc:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }
  .svc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .svc__icon { color: var(--accent); }
  .svc__num {
    font-family: var(--font-display);
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  .svc__title { font-size: var(--t-xl); margin-bottom: 0.45rem; }
  .svc__summary {
    font-size: var(--t-sm);
    color: var(--ink-2);
    flex: 1;
  }
  .svc__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.1rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--accent);
  }
  .svc:hover .svc__link :global(svg) { transform: translateX(3px); }
  .svc__link :global(svg) { transition: transform var(--dur) var(--ease); }
</style>
