---
/**
 * Arus Digital wordmark. The geometric "A" mark with brand-blue-to-teal
 * gradient, derived from the finalized logo SVG.
 */
interface Props {
  href?: string | null;
  tone?: 'ink' | 'light';
  class?: string;
}
const { href = '/', tone = 'ink', class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag
  {...href ? { href } : {}}
  class:list={['wordmark', `wordmark--${tone}`, className]}
  aria-label="Arus Digital — home"
>
  <svg class="wordmark__mark" width="28" height="28" viewBox="0 0 2048 2048" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="wm-g1" x1="0%" y1="20%" x2="100%" y2="80%">
        <stop offset="0%" stop-color="#1F49EE"/>
        <stop offset="100%" stop-color="#24BDFF"/>
      </linearGradient>
      <linearGradient id="wm-g2" x1="20%" y1="10%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#246EFF"/>
        <stop offset="100%" stop-color="#20E0C3"/>
      </linearGradient>
    </defs>
    <polygon points="455,1480 760,520 895,270 1030,520 900,1030 720,1285" fill="url(#wm-g1)"/>
    <polygon points="1045,1065 1205,650 1605,1490 1345,1395 1135,1265" fill="url(#wm-g2)"/>
  </svg>
  <span class="wordmark__text">Arus<span class="wordmark__text-2">&nbsp;Digital</span></span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 560;
    letter-spacing: -0.012em;
    text-decoration: none;
  }
  .wordmark__mark { flex: none; }

  .wordmark--ink .wordmark__text { color: var(--ink); }
  .wordmark--ink .wordmark__text-2 { color: var(--ink-3); }

  .wordmark--light .wordmark__text { color: var(--on-dark); }
  .wordmark--light .wordmark__text-2 { color: var(--on-dark-mute); }
</style>
