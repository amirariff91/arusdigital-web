---
import '@styles/global.css';
import SeoHead from '@components/SeoHead.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import ConsentBanner from '@components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, path, ogImage, noindex, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4ede1" />
    <!-- Mark JS active before paint so scroll-reveal only hides when it can un-hide. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SeoHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <ConsentBanner />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Scroll reveal — progressive enhancement. No JS / reduced-motion = visible.
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!els.length) return;
        if (
          !('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 300;
        background: var(--accent);
        color: var(--on-accent);
        padding: 0.6rem 1rem;
        border-radius: var(--r-sm);
        font-size: var(--t-sm);
        font-weight: 600;
        transition: top 0.2s var(--ease);
      }
      .skip-link:focus { top: 1rem; }
    </style>
  </body>
</html>
