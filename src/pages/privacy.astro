---
import Base from '@layouts/Base.astro';
import Reveal from '@components/Reveal.astro';
import CtaSection from '@components/CtaSection.astro';
import { site } from '@data/site';

const sections = [
  {
    id: 'who-we-are',
    title: 'Who we are',
    body: [
      `${site.legalName} is a digital agency and AI company based in Kuala Lumpur, Malaysia. We provide growth marketing, web development, software development, AI automation, and AI product services to businesses across Southeast Asia.`,
      `For the purposes of Malaysia's Personal Data Protection Act 2010 (PDPA), ${site.legalName} is the data controller responsible for your personal information collected through this website and our services.`,
    ],
    list: [
      `Company: ${site.legalName}`,
      'Location: Kuala Lumpur, Malaysia',
      `Email: ${site.email}`,
    ],
  },
  {
    id: 'what-we-collect',
    title: 'What data we collect',
    body: [
      'We only collect personal information that you voluntarily provide to us — for example, when you fill out the audit form, send us an email, or reach out via WhatsApp. The types of data we may collect include:',
    ],
    list: [
      'Full name',
      'Email address',
      'WhatsApp or phone number',
      'Business name and industry',
      'Any additional information you include in your message to us',
    ],
    after: [
      'We do not collect sensitive personal data (as defined under the PDPA) unless explicitly required and consented to for a specific service.',
    ],
  },
  {
    id: 'how-we-use-it',
    title: 'How we use it',
    body: ['We use the personal information you provide solely for legitimate business purposes. Specifically:'],
    list: [
      'To respond to your enquiries and provide quotations or proposals',
      'To deliver the services you have engaged us for',
      'To send service-related updates and communications',
      'To improve our website and service offerings based on feedback',
      'To comply with our legal and regulatory obligations',
    ],
    after: [
      `We will not use your personal data for unsolicited marketing without your prior consent. You may withdraw consent at any time by emailing us at ${site.email}.`,
    ],
  },
  {
    id: 'who-we-share-with',
    title: 'Who we share it with',
    body: [
      'We do not sell, rent, or trade your personal information to third parties. We may share your data only in the following limited circumstances:',
    ],
    list: [
      'With cloud hosting and infrastructure providers necessary to operate our services',
      'With analytics providers (e.g. Google Analytics) in anonymised or aggregated form',
      'Where required by law, regulation, or a valid legal request',
    ],
  },
  {
    id: 'data-storage',
    title: 'Data storage',
    body: [
      'Your personal data is stored on servers located in Malaysia and/or Singapore. We take reasonable technical and organisational measures to protect your data against unauthorised access, loss, or disclosure.',
      'We retain personal data only for as long as necessary to fulfil the purposes for which it was collected, or as required by applicable Malaysian law. When data is no longer needed, it is securely deleted or anonymised.',
    ],
  },
  {
    id: 'your-rights',
    title: 'Your rights',
    body: ['Under Malaysia\'s Personal Data Protection Act 2010, you have the following rights with respect to your personal data:'],
    list: [
      'Right of access — request a copy of the personal data we hold about you',
      'Right of correction — request correction of inaccurate or incomplete data',
      'Right to withdraw consent — withdraw your consent to processing at any time',
      'Right to limit processing — request that we limit processing in certain circumstances',
      'Right of deletion — request deletion of your personal data, subject to legal retention requirements',
    ],
    after: [
      `To exercise any of these rights, contact us at ${site.email}. We respond to all requests within 21 days in accordance with the PDPA.`,
    ],
  },
  {
    id: 'cookies',
    title: 'Cookies',
    body: [
      'Our website uses cookies to understand how visitors interact with the site. We use Google Analytics 4, which places cookies to collect anonymised usage data such as pages visited, time on site, and traffic sources. Analytics load only after you accept them in the cookie banner.',
    ],
    list: [
      'Analytics cookies (GA4) — help us understand site usage and improve our content',
      'No advertising or tracking cookies are used on this site',
      'No cookies are used to identify you personally',
    ],
    after: [
      'You can decline analytics cookies in the banner, or disable cookies at any time through your browser settings. Declining does not affect your ability to use this website.',
    ],
  },
  {
    id: 'contact-us',
    title: 'Contact us',
    body: [
      `If you have any questions about this privacy policy or how we handle your personal data, contact us at ${site.email} or via WhatsApp at ${site.whatsapp.display}.`,
    ],
  },
];
---
<Base
  title="Privacy Policy — Arus Digital"
  description="How Arus Digital collects, uses and protects your personal data, in line with Malaysia's Personal Data Protection Act 2010 (PDPA)."
  path="/privacy"
>
  <section class="section">
    <div class="container container-narrow">
      <Reveal class="pp-head">
        <p class="eyebrow">Legal</p>
        <h1>Privacy Policy</h1>
        <p class="lead">
          How we collect, use and protect your personal data — in line with
          Malaysia's Personal Data Protection Act 2010 (PDPA).
        </p>
      </Reveal>

      <Reveal class="pp-toc">
        <ol>
          {sections.map((s, i) => (
            <li><a href={`#${s.id}`}>{String(i + 1).padStart(2, '0')} · {s.title}</a></li>
          ))}
        </ol>
      </Reveal>

      <div class="pp-body">
        {sections.map((s, i) => (
          <Reveal as="section" class="pp-section" id={s.id}>
            <span class="pp-num">Section {String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            {s.body.map((p) => <p>{p}</p>)}
            {s.list && (
              <ul class="pp-list">
                {s.list.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {s.after && s.after.map((p) => <p>{p}</p>)}
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <CtaSection />
</Base>

<style>
  .pp-head { margin-bottom: 2rem; }
  .pp-head h1 { font-size: var(--t-3xl); margin: 0.7rem 0 0.8rem; }

  .pp-toc {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 1.25rem 1.4rem;
    margin-bottom: 2.5rem;
  }
  .pp-toc ol { display: grid; gap: 0.45rem; }
  @media (min-width: 560px) { .pp-toc ol { grid-template-columns: 1fr 1fr; } }
  .pp-toc a {
    font-size: var(--t-sm);
    color: var(--ink-2);
    transition: color var(--dur) var(--ease);
  }
  .pp-toc a:hover { color: var(--accent); }

  .pp-section { padding-top: 1.6rem; margin-top: 1.6rem; border-top: 1px solid var(--border); }
  .pp-section:first-child { border-top: 0; margin-top: 0; padding-top: 0; }
  .pp-num {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pp-section h2 { font-size: var(--t-xl); margin: 0.4rem 0 0.7rem; }
  .pp-section p { font-size: var(--t-sm); color: var(--ink-2); margin-bottom: 0.8rem; }
  .pp-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0 0 0.9rem;
    padding-left: 1.1rem;
  }
  .pp-list li {
    font-size: var(--t-sm);
    color: var(--ink-2);
    list-style: disc;
  }
</style>
